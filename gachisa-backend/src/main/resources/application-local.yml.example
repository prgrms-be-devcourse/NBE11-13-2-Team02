# 이 파일을 application-local.yml 로 복사해서 각자 로컬에서 사용하세요.
# application-local.yml 자체는 .gitignore에 등록되어 Git에는 올라가지 않습니다.

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/gachisa?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: gachisa
    password: gachisa1234
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    hibernate:
      ddl-auto: create-drop
    defer-datasource-initialization: true
    show-sql: true

  sql:
    init:
      mode: always

jwt:
  secret: local-dev-secret-change-me-1234567890
